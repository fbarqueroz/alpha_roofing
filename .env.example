# Correo del formulario de contacto (SMTP). Copia este archivo a .env.local y llena los valores.
# Ejemplos de servidor:
#   Gmail:  SMTP_HOST=smtp.gmail.com      SMTP_PORT=465  (usa una "contraseña de aplicación")
#   Yahoo:  SMTP_HOST=smtp.mail.yahoo.com SMTP_PORT=465  (usa una "contraseña de aplicación")
#   Resend: SMTP_HOST=smtp.resend.com     SMTP_PORT=465  SMTP_USER=resend  SMTP_PASS=re_xxx
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Quién recibe las solicitudes (por defecto el correo de la empresa)
CONTACT_TO=Avz5588@yahoo.com
# Remitente (debe estar autorizado en tu servidor SMTP; por defecto SMTP_USER)
CONTACT_FROM=
# Idioma del correo que recibe el dueño: es | en
CONTACT_EMAIL_LANG=es
